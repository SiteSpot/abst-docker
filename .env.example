# Copy to .env (install.sh writes this for you).

# The customer's site to run tests on.
ABST_DOMAIN=customer.com
ABST_LICENCE=
# 1 = heatmaps, page analytics and session replays on the customer's site.
ABST_JOURNEYS=
# 1 = install the MCP Adapter so AI assistants (Claude, Cursor...) can manage tests.
# Needs HTTPS. `docker compose exec app abst mcp` prints the client config.
ABST_MCP=

# Public URL of this split-test server. The customer's pages load the embed
# script from here, so it must be HTTPS for an HTTPS site.
ABST_URL=https://abst.example.com
# With the "tls" profile Caddy gets a certificate for this hostname.
ABST_HOSTNAME=abst.example.com
COMPOSE_PROFILES=tls

# Where the WordPress container listens on the host (behind Caddy or your proxy).
ABST_BIND=127.0.0.1
ABST_HTTP_PORT=8080

# WordPress admin (the admin UI stays at $ABST_URL/wp-admin/).
ABST_ADMIN_USER=admin
ABST_ADMIN_PASSWORD=change-me
ABST_ADMIN_EMAIL=admin@example.com

ABST_DB_PASSWORD=change-me
ABST_DB_ROOT_PASSWORD=change-me
